\set QUIET 1

-- dbstatus: a human name for the server we're on, derived from whether it
-- accepts writes. dbcolor is the ANSI SGR code to color it with (red for a
-- writable primary, green for a read-only replica). Servers that don't
-- expose transaction_read_only (e.g. Redshift) fall back to a yellow
-- 'redshift' label.
select
  coalesce(s.dbstatus, 'redshift') as dbstatus,
  coalesce(s.dbcolor, '1;33') as dbcolor
from (
  select
    case setting
      when 'off' then 'PROD'
      when 'on' then
        case when :'HOST' like '%data-science%' then 'replica-ml' else 'replica' end
    end as dbstatus,
    case setting
      when 'off' then '1;31'
      when 'on' then '1;32'
    end as dbcolor
  from pg_settings where name = 'transaction_read_only'
) s \gset

\set PROMPT1 '%[%033[%:dbcolor:m%]%:dbstatus:%[%033[0m%] %n@%/%R%#%x '
\set PROMPT2 '%:dbstatus: %/%R%#%x'
\pset null '[null]'

\set COMP_KEYWORD_CASE preserve-upper

\timing

\set HISTSIZE 2000
-- Separate history per server: HOST is the socket directory (contains '/')
-- for local connections, which would build a bogus nested path, so those
-- just fall back to one shared history keyed by database+status.
\set is_socket `case :'HOST' in /*) echo 1 ;; *) echo 0 ;; esac`
\if :is_socket
\set HISTFILE ~/.psql_history-:DBNAME-:dbstatus
\else
\set HISTFILE ~/.psql_history-:HOST-:DBNAME-:dbstatus
\endif

\x auto

\set VERBOSITY verbose

\set QUIET 0

\echo 'Welcome to PostgreSQL! \n'
\echo 'Type :version to see the PostgreSQL version.'
\echo 'Type :extensions to see the available extensions.'
\echo 'Type \\q to exit. \n'

\set version 'SELECT version();'
\set extensions 'select * from pg_available_extensions;'
